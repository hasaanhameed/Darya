# Copy to .env and fill in. Never commit .env.
# Supabase -> Connect -> Session pooler. Keep the "+asyncpg" part of the scheme.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Data-source accounts (optional; only needed by the ingestion script that uses them).
# GloFAS: API token from your profile at https://ewds.climate.copernicus.eu (accept the CEMS-FLOODS licence too).
EWDS_API_KEY=
# IMERG: free account at https://urs.earthdata.nasa.gov, then approve the "NASA GESDISC DATA ARCHIVE"
# application in your profile (Applications -> Authorized Apps).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
